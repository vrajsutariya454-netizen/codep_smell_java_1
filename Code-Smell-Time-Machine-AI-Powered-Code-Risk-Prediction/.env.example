# Database URL - supports both PostgreSQL and SQLite
# For PostgreSQL: postgresql://user:password@localhost:5432/repo_analyzer
# For SQLite (local testing): sqlite:///./repo_analyzer.db
DATABASE_URL=sqlite:///./repo_analyzer.db

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Server Configuration
DEBUG=True
